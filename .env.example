# ==============================================================================
# DataPulse — Environment Configuration Template
# Copy this file to '.env' for local development or production deployment.
# NEVER commit the active '.env' file or secret credentials to Git.
# ==============================================================================

# Application Settings
PROJECT_NAME="DataPulse — Smart Campus Analytics & Predictive Intelligence"
VERSION="2.0.0"
DEBUG=false
API_PREFIX=/api

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Option 1: Local Development SQLite (Default fallback if unset)
DATABASE_URL=sqlite:///./datapulse.db

# Option 2: Docker Compose or Local PostgreSQL 16
# DATABASE_URL=postgresql://datapulse_user:datapulse_secure_password@localhost:5432/datapulse_db

# Option 3: Managed Cloud PostgreSQL (Supabase / Neon / AWS RDS / Render)
# DATABASE_URL=postgresql://username:password@cloud-host.region.provider.com:5432/datapulse_db?sslmode=require

# PostgreSQL Docker Compose Service Credentials
POSTGRES_USER=datapulse_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=datapulse_db

# PostgreSQL Connection Pooling & Performance Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
SQL_ECHO=false

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_cryptographically_secure_random_token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (JSON list format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","http://localhost:80"]

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
