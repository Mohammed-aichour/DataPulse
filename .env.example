# DataPulse Environment Configuration

# Application
PROJECT_NAME="DataPulse — Smart Campus Analytics & Predictive Intelligence"
DEBUG=false
API_PREFIX=/api

# Database Configuration
# Local SQLite Default:
DATABASE_URL=sqlite:///./datapulse.db
# Docker Compose PostgreSQL:
# DATABASE_URL=postgresql://datapulse_user:datapulse_secure_password@db:5432/datapulse_db

# Security & CORS
JWT_SECRET=datapulse-production-secret-key-uia-agadir-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api
