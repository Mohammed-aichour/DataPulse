# ==============================================================================
# DataPulse — Environment Configuration Template
# Copy this file to '.env' for local development or production deployment:
#   cp .env.example .env
# NEVER commit the active '.env' file or secret credentials to Git.
# ==============================================================================

# Application Settings
PROJECT_NAME="DataPulse — Smart Campus Analytics & Predictive Intelligence"
VERSION="2.0.0"
DEBUG=false
API_PREFIX=/api

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Option 1: Local Development SQLite (Default fallback if unset)
DATABASE_URL=sqlite:///./datapulse.db

# Option 2: Docker Compose or Local PostgreSQL 16 (Require strong credentials)
# DATABASE_URL=postgresql+psycopg2://datapulse_user:YOUR_STRONG_POSTGRES_PASSWORD@127.0.0.1:5432/datapulse_db

# Option 3: Managed Cloud PostgreSQL (Supabase / Neon / AWS RDS / Render)
# DATABASE_URL=postgresql+psycopg2://username:YOUR_CLOUD_PASSWORD@cloud-host.region.provider.com:5432/datapulse_db?sslmode=require

# PostgreSQL Docker Compose Service Credentials (REQUIRED for docker-compose up)
# Generate a strong password: e.g. python -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_USER=datapulse_user
POSTGRES_PASSWORD=YOUR_STRONG_LOCAL_POSTGRES_PASSWORD_HERE
POSTGRES_DB=datapulse_db

# PostgreSQL Connection Pooling & Performance Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
SQL_ECHO=false

# ------------------------------------------------------------------------------
# Security & Authentication (REQUIRED)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32  OR  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=YOUR_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (JSON list format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:80"]

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# In local dev: http://localhost:8000/api
# In production with Nginx reverse proxy: /api
VITE_API_URL=http://localhost:8000/api
